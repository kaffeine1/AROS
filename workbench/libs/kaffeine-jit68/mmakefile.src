#
# kaffeine-jit68.library: an optional 68k execution engine for
# m68kemu.library, behind the interface of rom/m68kemu/m68kemu_engine.h.
#
# The translator emits AArch64 code, so the library is built for AArch64
# targets only. m68kemu.library runs without it.

include $(SRCDIR)/config/aros.cfg

#MM- workbench-libs : workbench-libs-kaffeine-jit68-$(AROS_TARGET_CPU)
#MM- workbench-libs-kaffeine-jit68-aarch64 : workbench-libs-kaffeine-jit68

FILES := kj68_library kj68_engine kj68_translate kj68_platform

# the interface the engine implements is m68kemu's
USER_CPPFLAGS := -I$(SRCDIR)/rom/m68kemu
USER_LDFLAGS := -static

%build_module mmake=workbench-libs-kaffeine-jit68 \
    modname=kaffeine-jit68 modtype=library \
    files="$(FILES)"

%common
